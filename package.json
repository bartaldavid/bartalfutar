{
  "name": "bartalfutar-sveltekit",
  "version": "0.5.0",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "generate": "drizzle-kit generate:mysql",
    "db:push": "drizzle-kit push:mysql",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --plugin-search-dir . --check . && eslint .",
    "format": "prettier --write  --plugin prettier-plugin-svelte .",
    "generate:schema": "openapi-typescript https://opendata.bkk.hu/docs/futar-openapi.yaml -o ./src/lib/schema-generated.ts"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@iconify-json/material-symbols": "^1.2.90",
    "@inlang/paraglide-js": "2.25.0",
    "@internationalized/date": "^3.12.4",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/eslint": "^9.6.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vite-pwa/sveltekit": "^1.1.0",
    "autoprefixer": "^10.5.4",
    "bits-ui": "2.19.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn-svelte": "^1.6.1",
    "svelte": "5.57.0",
    "svelte-check": "^4.7.6",
    "svelte-radix": "^3.0.2",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "unplugin-icons": "^23.0.1",
    "vite": "^8.2.2"
